# Supabase Public Configuration (Safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Supabase Server-Side Configuration (Keep secret, never expose in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Discord OAuth2 (Server-Side Confidential Client + CSRF/PKCE state signing)
DISCORD_CLIENT_ID=1557993745884905512
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret
OAUTH_STATE_SECRET=generate_32_byte_random_hex_secret
PORTAL_SESSION_SECRET=generate_32_byte_random_hex_secret

# Payment Provider Webhook Secret (SellAuth)
SELLAUTH_WEBHOOK_SECRET=your_sellauth_webhook_secret

# Release Signing Keys (Ed25519)
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
